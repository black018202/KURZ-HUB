-- ESP BOX (quadrado vermelho forte no torso)
-------------------------------------------------
local function getTorso(char)
    return char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

local function clearESPBox()
    if espBoxFolder then
        espBoxFolder:Destroy()
        espBoxFolder = nil
    end
    for _, conn in pairs(espBoxConnections) do
        if typeof(conn) == "RBXScriptConnection" then
            conn:Disconnect()
        end
    end
    table.clear(espBoxConnections)
end

local function createESPBoxForPlayer(player)
    if player == LocalPlayer then return end
    if not espBoxFolder then return end

    local function setupCharacter(char)
        if not char or not espBoxFolder then return end

        local old = espBoxFolder:FindFirstChild(player.Name)
        if old then old:Destroy() end

        local torso = getTorso(char)
        if not torso then return end

        local box = Instance.new("BoxHandleAdornment")
        box.Name = player.Name
        box.Adornee = torso
        box.Size = Vector3.new(2.2, 2.2, 1.2) -- tamanho do torso
        box.Color3 = Color3.fromRGB(255, 0, 0) -- vermelho forte
        box.AlwaysOnTop = true
        box.ZIndex = 10
        box.Transparency = 0 -- sem transparência
        box.Parent = espBoxFolder
    end

    if player.Character then
        setupCharacter(player.Character)
    end

    local conn = player.CharacterAdded:Connect(function(char)
        task.wait(0.15)
        setupCharacter(char)
    end)
    table.insert(espBoxConnections, conn)
end

local function setESPBox(state)
    config.espBox = state
    saveConfig()
    clearESPBox()

    if not state then return end

    espBoxFolder = Instance.new("Folder")
    espBoxFolder.Name = "KurzESPBox"
    espBoxFolder.Parent = CoreGui

    for _, player in ipairs(Players:GetPlayers()) do
        createESPBoxForPlayer(player)
    end

    local joinConn = Players.PlayerAdded:Connect(function(player)
        createESPBoxForPlayer(player)
    end)
    table.insert(espBoxConnections, joinConn)

    local leaveConn = Players.PlayerRemoving:Connect(function(player)
        if espBoxFolder then
            local b = espBoxFolder:FindFirstChild(player.Name)
            if b then b:Destroy() end
        end
    end)
    table.insert(espBoxConnections, leaveConn)
end

