UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if UserInputService:GetFocusedTextBox() then return end

    if input.UserInputType == Enum.UserInputType.Keyboard then
        local keyName = input.KeyCode.Name

        if listeningForKey == "speed" then
            config.speedKey = keyName
            speedKeyBtn.Text = keyName
            speedKeyBtn.TextColor3 = Color3.fromRGB(255, 80, 80)
            listeningForKey = nil
            saveConfig()
            return
        end

        if config.keybindSpeedEnabled then
            local success, keyEnum = pcall(function()
                return Enum.KeyCode[config.speedKey]
            end)
            if success and input.KeyCode == keyEnum then
                setSpeedBoost(not config.speedBoost)
                if setSpeedToggle then
                    setSpeedToggle(config.speedBoost)
                end
            end
        end
    end
end)

